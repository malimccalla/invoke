{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://invoke.works/ns/work#",

    "work": "https://invoke.works/ns/work#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "$schema": { "@id": "work:conformsToSchema", "@type": "@id" },
    "spec_version": "work:specVersion",
    "work_id": "work:workId",
    "version": "work:version",
    "parent": "work:parent",
    "created_at": { "@id": "dcterms:created", "@type": "xsd:dateTime" },
    "status": "work:status",
    "ext": { "@id": "work:ext", "@type": "@json" },

    "identity": {
      "@id": "work:identity",
      "@context": {
        "title": "schema:name",
        "iswc": "schema:iswcCode",
        "language": "schema:inLanguage",
        "duration_ms": "work:durationMs",
        "created_year": "schema:dateCreated",
        "alternative_titles": { "@id": "schema:alternateName", "@container": "@set" }
      }
    },

    "musical_attributes": {
      "@id": "work:musicalAttributes",
      "@context": {
        "key": "work:musicalKey",
        "tempo_bpm": "work:tempoBpm",
        "metre": "work:metre"
      }
    },

    "content": { "@id": "work:content", "@container": "@set" },
    "evidence": { "@id": "work:evidence", "@container": "@set" },
    "renders": { "@id": "work:render", "@container": "@set" },

    "role": "work:role",
    "subrole": "work:subrole",
    "media_type": { "@id": "dcterms:format" },
    "digest": "work:digest",
    "size": "schema:contentSize",
    "derived": "work:derived",
    "attested_by": "work:attestedBy",
    "computed_over": "work:computedOver",
    "algorithm": "work:algorithm",
    "disclosure": "work:disclosure",
    "locators": { "@id": "schema:contentUrl", "@type": "@id", "@container": "@list" },
    "isrc": "schema:isrcCode",
    "recorded_at": { "@id": "work:recordedAt", "@type": "xsd:date" },

    "attestations": { "@id": "work:attestation", "@container": "@list" },
    "claim": "work:claim",
    "attestor": "work:attestor",
    "created": { "@id": "dcterms:created", "@type": "xsd:dateTime" },
    "confidence": "work:confidence",

    "render_id": "work:renderId",
    "purpose": "work:purpose",
    "style_prompt": "work:stylePrompt",
    "engine": { "@id": "prov:wasGeneratedBy" },
    "rendered_at": { "@id": "work:renderedAt", "@type": "xsd:dateTime" },
    "use_class": "work:useClass",
    "melody_similarity": "work:melodySimilarity",
    "human_in_loop": "work:humanInLoop",
    "copyright_note": "work:copyrightNote",
    "consent_coverage_bps": "work:consentCoverageBps",
    "consent_note": "work:consentNote",
    "distribution_restriction": "work:distributionRestriction",

    "rights": "work:rights",
    "parties": { "@id": "work:party", "@container": "@set" },
    "credits": { "@id": "work:credit", "@container": "@set" },
    "publisher_for_writer": { "@id": "work:publisherForWriter", "@container": "@set" },
    "agreements": { "@id": "work:agreement", "@container": "@set" },
    "totals_bps": "work:totalsBps",
    "ownership": "work:ownership",
    "pr": "work:performingRight",
    "mr": "work:mechanicalRight",
    "sr": "work:synchronisationRight",

    "party_id": "work:partyId",
    "canonical_party_id": "work:canonicalPartyId",
    "name": "schema:legalName",
    "last_name": "schema:familyName",
    "first_name": "schema:givenName",
    "ipi_name_number": "work:ipiNameNumber",
    "ipi_base_number": "work:ipiBaseNumber",
    "isni": "work:isni",
    "ddex_party_id": "work:ddexPartyId",
    "societies": "work:societies",

    "credit_id": "work:creditId",
    "writer_designation": "work:writerDesignation",
    "publisher_type": "work:publisherType",
    "controlled": "work:controlled",
    "cwr_record": "work:cwrRecord",
    "agreement_id": "work:agreementId",
    "publisher_sequence": "work:publisherSequence",
    "ownership_bps": "work:ownershipBps",
    "effective_from": { "@id": "work:effectiveFrom", "@type": "xsd:date" },
    "effective_to": { "@id": "work:effectiveTo", "@type": "xsd:date" },
    "territory_claims": { "@id": "work:territoryClaim", "@container": "@set" },
    "tis_code": "work:tisCode",
    "tis_name": "work:tisName",
    "indicator": "work:indicator",
    "collection_bps": "work:collectionBps",
    "writer_credit_id": "work:writerCreditId",
    "publisher_credit_id": "work:publisherCreditId",

    "agreement_type": "work:agreementType",
    "assignor_party_id": "work:assignorPartyId",
    "assignee_party_id": "work:assigneePartyId",
    "start_date": { "@id": "work:startDate", "@type": "xsd:date" },
    "end_date": { "@id": "work:endDate", "@type": "xsd:date" },
    "retention_end_date": { "@id": "work:retentionEndDate", "@type": "xsd:date" },
    "post_term_collection_end_date": { "@id": "work:postTermCollectionEndDate", "@type": "xsd:date" },
    "prior_royalty_status": "work:priorRoyaltyStatus",
    "sales_manufacture_clause": "work:salesManufactureClause",
    "admin_commission_bps": "work:adminCommissionBps",
    "document_digest": "work:documentDigest",

    "derivation": { "@id": "work:derivation", "@container": "@set" },
    "relation_type": "work:relationType",
    "parent_work_id": "work:parentWorkId",
    "parent_iswc": "work:parentIswc",
    "parent_title": "work:parentTitle",
    "parent_locators": { "@id": "work:parentLocator", "@type": "@id", "@container": "@list" },
    "affected_components": { "@id": "work:affectedComponent", "@container": "@set" },
    "description": "dcterms:description",
    "disposition": "work:disposition",
    "clearance_id": "work:clearanceId",
    "dispute_id": "work:disputeId",

    "related_works": { "@id": "work:relatedWork", "@container": "@set" },
    "relation": "work:relation",
    "related_work_id": "work:relatedWorkId",
    "related_iswc": "work:relatedIswc",
    "related_title": "work:relatedTitle",
    "related_locators": { "@id": "work:relatedLocator", "@type": "@id", "@container": "@list" },
    "matched_components": { "@id": "work:matchedComponent", "@container": "@set" },
    "method": "work:method",
    "score": "work:score",

    "clearances": { "@id": "work:clearance", "@container": "@set" },
    "granted_by": "work:grantedBy",
    "granted_on": { "@id": "work:grantedOn", "@type": "xsd:date" },
    "terms": "work:terms",
    "consideration": {
      "@id": "work:consideration",
      "@context": {
        "basis": "work:considerationBasis",
        "bps": "work:bps",
        "beneficiary_party_id": "work:beneficiaryPartyId",
        "territory": "work:territory",
        "term": "work:term"
      }
    },
    "affects_ownership": "work:affectsOwnership",

    "mandates": { "@id": "odrl:hasPolicy", "@container": "@set" },
    "mandate_id": "work:mandateId",
    "granted_to": { "@id": "odrl:assignee" },
    "territories": { "@id": "work:territory", "@container": "@set" },
    "use_classes": { "@id": "odrl:action", "@container": "@set" },
    "rate_floor": "work:rateFloor",
    "currency": "work:currency",
    "minor_units": "work:minorUnits",
    "exclusions": { "@id": "odrl:prohibition", "@container": "@set" },

    "clearability": "work:clearability",
    "computed_at": { "@id": "work:computedAt", "@type": "xsd:dateTime" },
    "request": "work:request",
    "one_stop": "work:oneStop",
    "coverage_bps": "work:coverageBps",
    "gaps": { "@id": "work:gap", "@container": "@set" },
    "bps": "work:bps",
    "reason": "work:reason",

    "registrations": { "@id": "work:registration", "@container": "@set" },
    "society_code": "work:societyCode",
    "recipient_code": "work:recipientCode",
    "society_name": "work:societyName",
    "transaction_type": "work:transactionType",
    "submitted_at": { "@id": "work:submittedAt", "@type": "xsd:dateTime" },
    "file": "work:file",
    "ack_status": "work:ackStatus",
    "ack_received_at": { "@id": "work:ackReceivedAt", "@type": "xsd:dateTime" },
    "society_work_code": "work:societyWorkCode",
    "allocated_iswc": "work:allocatedIswc",
    "messages": { "@id": "work:message", "@container": "@list" },

    "disputes": { "@id": "work:dispute", "@container": "@set" },
    "raised_at": { "@id": "work:raisedAt", "@type": "xsd:date" },
    "claimant": { "@id": "work:claimant" },
    "claimed_parent_title": "work:claimedParentTitle",
    "claimed_parent_iswc": "work:claimedParentIswc",
    "disputed_components": { "@id": "work:disputedComponent", "@container": "@set" },
    "forum": "work:forum",
    "response": "work:response",
    "resolved_at": { "@id": "work:resolvedAt", "@type": "xsd:date" },
    "resolution": "work:resolution",
    "document_digests": { "@id": "work:documentDigest", "@container": "@set" },

    "provenance_log": "work:provenanceLog",
    "provenance_recent": { "@id": "prov:wasInfluencedBy", "@container": "@list" },
    "at": { "@id": "prov:atTime", "@type": "xsd:dateTime" },
    "actor": { "@id": "prov:wasAttributedTo" },
    "action": "work:action",
    "target": "work:target",
    "from": { "@id": "prov:wasDerivedFrom" },
    "note": "work:note",

    "timestamps": { "@id": "work:timestamp", "@container": "@set" },
    "authority": "work:authority",
    "qualified": "work:qualified",
    "qualification_note": "work:qualificationNote",
    "stamped_at": { "@id": "work:stampedAt", "@type": "xsd:dateTime" },
    "token": "work:token",

    "signatures": { "@id": "work:signature", "@container": "@set" },
    "key_id": "work:keyId",
    "canonicalisation": "work:canonicalisation",
    "signed_at": { "@id": "work:signedAt", "@type": "xsd:dateTime" },
    "value": "work:value"
  }
}
